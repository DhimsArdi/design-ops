# Supabase project credentials (docs/PRD.MD §34).
# Copy to .env.local and fill in — .env.local is gitignored.
#
# Both are safe to expose to the browser: the anon key only ever grants what the
# Row Level Security policies in supabase/schema.sql allow. Never put the
# service_role key in a NEXT_PUBLIC_ variable — it bypasses RLS entirely.
#
# Dashboard → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
